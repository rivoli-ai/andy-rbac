<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Andy.Rbac</PackageId>
    <Description>RBAC (Role-Based Access Control) library for Andy applications. Provides permission checking, policy-based authorization, and integration with ASP.NET Core.</Description>
    <PackageTags>rbac;authorization;permissions;security</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\andy_rbac_icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
